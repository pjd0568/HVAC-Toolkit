# Flask sessions — required in production (generate a long random string).
SECRET_KEY=change-me-to-a-long-random-string

# Postgres — Compose default below; Railway injects DATABASE_URL when you
# attach the Postgres plugin. Both postgres:// and postgresql:// are accepted.
DATABASE_URL=postgresql://app:app@db:5432/app

# Brand (shown on marketing pages, PDF headers, nav)
BRAND_NAME=HVAC Calcs
BRAND_TAG=coming soon

# Public self-serve signup (default off in production). Set true to open trials.
# REGISTRATION_OPEN=true
REGISTRATION_OPEN=false

# Optional: force Free / Trial / Pro UI while developing (unset in production)
# ACCESS_DEV_TIER=free
# ACCESS_DEV_TIER=trial
# ACCESS_DEV_TIER=pro

# Gunicorn listen port (Railway sets this automatically)
PORT=8000
