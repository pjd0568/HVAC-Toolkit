# Flask sessions — required in production (generate a long random string).
SECRET_KEY=change-me-to-a-long-random-string

# Postgres — for Flask on your Mac use 127.0.0.1 (Compose publishes 5432).
# Inside Compose / the web container, use host `db` instead.
# Railway injects DATABASE_URL when you attach the Postgres plugin.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# Brand (shown on marketing pages, PDF headers, nav)
BRAND_NAME=hvac-calcs.app
BRAND_TAG=Psychrometrics, Ducts & Pipework. Simplified.

# Optional brand asset overrides (defaults live in web/app/static/images/brand/)
# BRAND_MARK=images/brand/icon.png
# BRAND_LOCKUP=images/brand/lockup-tagline.png
# BRAND_HERO=images/brand/home-hero.png
# BRAND_FAVICON=images/brand/favicon-32.png
# BRAND_APPLE_TOUCH=images/brand/apple-touch-icon.png
# BRAND_ASSET_VERSION=20260728a
# PDF header logo — leave unset to use packaged logo-pdf.png; set to a company logo later
# REPORT_LOGO_PATH=/absolute/path/to/company-logo.png

# App shell is V2-only (classic UI retired). UI_DEFAULT is ignored if set.
# UI_DEFAULT=v2

# Public site URL (canonical links, sitemap, Open Graph)
PUBLIC_BASE_URL=https://hvac-calcs.app

# Legal / contact (Terms, Privacy, Contact form)
LEGAL_ENTITY=PJD IT Systems
LEGAL_JURISDICTION=England and Wales
CONTACT_EMAIL=info@hvac-calcs.app

# Preferred on Railway: Resend (https://resend.com) — verify hvac-calcs.app domain, then:
# RESEND_API_KEY=re_...
# MAIL_DEFAULT_SENDER=info@hvac-calcs.app

# Optional SMTP fallback (often blocked from Railway to Gmail — prefer Resend)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=info@hvac-calcs.app
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=info@hvac-calcs.app

# Optional: force trial-ended / trial / subscribed UI while developing (unset in production)
# ACCESS_DEV_TIER=free
# ACCESS_DEV_TIER=trial
# ACCESS_DEV_TIER=pro

# Stripe — start in Test mode: https://dashboard.stripe.com/test/apikeys
# Accept Managed Payments terms at https://dashboard.stripe.com/test/settings/managed-payments
# Copy .env.example → .env and paste real values (app loads .env via python-dotenv).
# Full dogfood + live cutover: docs/go-live-checklist.md
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Dashboard → Developers → Webhooks
#   (endpoint URL: https://YOUR_HOST/webhooks/stripe ; events: checkout.session.completed,
#    checkout.session.async_payment_succeeded, customer.subscription.updated,
#    customer.subscription.deleted)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID after creating the product (Dashboard or: flask --app wsgi ensure-stripe-product)
# STRIPE_PRICE_ID=price_...
# STRIPE_MANAGED_PAYMENTS=true
# Live mode: replace sk_test_/whsec_/price_ with live values on Railway only after
# the Test walkthrough in docs/go-live-checklist.md passes.

# Cloudflare Turnstile on /register (optional locally; set both on Railway while
# REGISTRATION_OPEN=true). Dashboard: https://dash.cloudflare.com/ → Turnstile
# Hostnames: hvac-calcs.app (and localhost for local testing).
# TURNSTILE_SITE_KEY=0x4AAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAA...

# Gunicorn listen port (Railway sets this automatically)
PORT=8000
